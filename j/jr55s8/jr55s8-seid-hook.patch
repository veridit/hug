diff --git a/compiler/test/infra/test_commit_msg_attribution_guard.sh b/compiler/test/infra/test_commit_msg_attribution_guard.sh
index 86fcaa3..7080f0b 100755
--- a/compiler/test/infra/test_commit_msg_attribution_guard.sh
+++ b/compiler/test/infra/test_commit_msg_attribution_guard.sh
@@ -1,25 +1,24 @@
 #!/bin/bash
-# Regression checks for .githooks/commit-msg. Runs in an isolated git repo so
-# exemption sentinel files never touch the caller's real .git directory.
+# Regression checks for .githooks/commit-msg, the call into hug's Model: gate
+# (hug jr55s8). Runs in an isolated git repo so exemption sentinel files never
+# touch the caller's real .git directory. Needs hug on PATH; without it the
+# checks are skipped with a message (the tracked hook itself refuses then).
 
 set -u
 
 SOURCE_ROOT=$(git -C "$(dirname "$0")/../../.." rev-parse --show-toplevel)
 SOURCE_HOOK="$SOURCE_ROOT/.githooks/commit-msg"
-SOURCE_ROSTER="$SOURCE_ROOT/.githooks/known-models.txt"
 TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/seid-commit-msg-test.XXXXXX")
 trap 'rm -rf "$TMP_ROOT"' EXIT INT TERM HUP
 
 REPO="$TMP_ROOT/repo"
 MSG="$TMP_ROOT/message"
 OUT="$TMP_ROOT/output"
-PATTERNS="$TMP_ROOT/patterns"
-SAMPLES="$TMP_ROOT/samples"
 
 mkdir -p "$REPO/.githooks"
-git -C "$REPO" init -q
+git -C "$REPO" init -q -b master
+git -C "$REPO" config core.hooksPath .githooks
 cp "$SOURCE_HOOK" "$REPO/.githooks/commit-msg"
-cp "$SOURCE_ROSTER" "$REPO/.githooks/known-models.txt"
 chmod +x "$REPO/.githooks/commit-msg"
 HOOK="$REPO/.githooks/commit-msg"
 GIT_DIR=$(git -C "$REPO" rev-parse --absolute-git-dir)
@@ -40,120 +39,43 @@ not_ok() {
 
 invoke() {
   : > "$OUT"
-  "$HOOK" "$MSG" >"$OUT" 2>&1
+  (cd "$REPO" && "$HOOK" "$MSG") >"$OUT" 2>&1
   return $?
 }
 
 accept() {
-  label=$1
-  body=$2
-  printf '%b\n' "$body" > "$MSG"
-  if invoke; then ok "$label"; else not_ok "$label (expected acceptance)"; fi
+  printf '%b\n' "$2" > "$MSG"
+  if invoke; then ok "$1"; else not_ok "$1 (expected acceptance)"; fi
 }
 
 refuse() {
-  label=$1
-  body=$2
-  expected=$3
-  printf '%b\n' "$body" > "$MSG"
+  printf '%b\n' "$2" > "$MSG"
   if invoke; then
-    not_ok "$label (expected refusal)"
-  elif grep -q "$expected" "$OUT"; then
-    ok "$label"
+    not_ok "$1 (expected refusal)"
+  elif grep -qF -- "$3" "$OUT"; then
+    ok "$1"
   else
-    not_ok "$label (wrong refusal; wanted: $expected)"
+    not_ok "$1 (refused without '$3')"
   fi
 }
 
-# One sample per non-comment roster regex, in the same order. Pairwise matching
-# below means a new roster family must add an explicit regression sample.
-grep -vE '^[[:space:]]*(#|$)' "$SOURCE_ROSTER" > "$PATTERNS"
-cat > "$SAMPLES" <<'EOF'
-Claude Opus 5|noreply@anthropic.com
-Claude Sonnet 5|noreply@anthropic.com
-Claude Haiku 4.5|noreply@anthropic.com
-Claude Fable 5|noreply@anthropic.com
-Claude 5|noreply@anthropic.com
-GPT-5.6 Terra|noreply@openai.com
-GPT-5.6 Luna|noreply@openai.com
-GPT-5.6 Sol|noreply@openai.com
-GPT Terra|noreply@openai.com
-GPT Luna|noreply@openai.com
-GPT Sol|noreply@openai.com
-GPT-5.6|noreply@openai.com
-o3|noreply@openai.com
-DeepSeek v4 Pro|noreply@deepseek.com
-DeepSeek v4 Flash|noreply@deepseek.com
-DeepSeek v4|noreply@deepseek.com
-Kimi K3|noreply@moonshot.cn
-Gemini 2.5 Pro|noreply@google.com
-Llama 4 Scout|noreply@meta.com
-Mistral Large 2|noreply@mistral.ai
-Codestral 25.01|noreply@mistral.ai
-Grok 4|noreply@x.ai
-Qwen 3 Coder|noreply@alibaba.com
-EOF
-
-pattern_count=$(wc -l < "$PATTERNS" | tr -d ' ')
-sample_count=$(wc -l < "$SAMPLES" | tr -d ' ')
-if [ "$pattern_count" -eq "$sample_count" ]; then
-  ok "roster has one regression sample per regex ($pattern_count)"
-else
-  not_ok "roster/sample count differs: $pattern_count regexes, $sample_count samples"
-fi
+# Without hug's gate installed the tracked hook refuses, naming the fix.
+refuse "gate not installed" "test: x\n\nModel: claude-opus-5-5/high" "fix: hug task install commit-msg"
 
-i=0
-while IFS='|' read -r model email; do
-  i=$((i + 1))
-  pattern=$(sed -n "${i}p" "$PATTERNS")
-  if printf '%s\n' "$model" | grep -qiE "$pattern"; then
-    ok "roster regex $i matches its sample"
-  else
-    printf 'pattern: %s\nsample:  %s\n' "$pattern" "$model" > "$OUT"
-    not_ok "roster regex $i does not match its sample"
-  fi
-  accept "hook accepts roster family $i" "test: accepted family $i\n\nCo-Authored-By: $model <$email>"
-done < "$SAMPLES"
-
-refuse "missing trailer" "test: no attribution" "missing Co-Authored-By trailer"
-MISSING_OUTPUT=$(cat "$OUT")
-
-refuse "generic identity" "test: generic\n\nCo-Authored-By: AI <ai@example.com>" "not a known model"
-refuse "unrostered identity" "test: unknown\n\nCo-Authored-By: Fictional Model 9 <noreply@example.com>" "not a known model"
-refuse "name slot copied" "test: slot\n\nCo-Authored-By: <provider-and-model-family> <noreply@example.com>" "slot was pasted"
-refuse "full shape copied" "test: shape\n\nCo-Authored-By: <provider-model-family-and-version> <noreply@<vendor>.com>" "slot was pasted"
-refuse "missing email" "test: malformed\n\nCo-Authored-By: GPT-5.6 Sol" "malformed Co-Authored-By trailer"
-refuse "nested email slot" "test: malformed\n\nCo-Authored-By: GPT-5.6 Sol <noreply@<vendor>.com>" "slot was pasted"
-refuse "trailing garbage" "test: malformed\n\nCo-Authored-By: GPT-5.6 Sol <noreply@openai.com> copied" "malformed Co-Authored-By trailer"
-refuse "second email" "test: malformed\n\nCo-Authored-By: GPT-5.6 Sol <noreply@openai.com> <other@example.com>" "malformed Co-Authored-By trailer"
-
-# Every complete trailer printed by the refusal must itself be refused. Also
-# ensure none of the concrete accepted samples leaks into the guidance text.
-printf '%s\n' "$MISSING_OUTPUT" | grep 'Co-Authored-By:' | while IFS= read -r shown; do
-  shown=$(printf '%s' "$shown" | sed -E 's/^[[:space:]]+//')
-  printf 'test: copied guidance\n\n%s\n' "$shown" > "$MSG"
-  if "$HOOK" "$MSG" >/dev/null 2>&1; then
-    printf '%s\n' "$shown" >> "$TMP_ROOT/copyable-guidance"
-  fi
-done
