-# Known models — the roster of agents permitted to author commits here.
-#
-# WHY THIS FILE EXISTS (King, 2026-08-26):
-#
-# Every agent commits as Jørgen H. Fjeld <jorgen@veridit.no> with the King's
-# signing key. Author, committer and signature are IDENTICAL for every agent, so
-# git alone cannot say who did the work. The Co-Authored-By trailer is the only
-# attribution channel this repo has, and it was used ZERO times in the 1500
-# commits before enforcement.
-#
-# A hook cannot verify that a model tells the truth about itself. What it CAN do
-# is refuse names that are not real models, so an agent must make a deliberate,
-# specific claim rather than pasting whatever the error message showed it. The
-# hook therefore prints only GENERIC family templates whose <...> slots are
-# refused: the guidance cannot be copied, only completed.
-#
-# FORMAT: one regex per line, matched case-insensitively against the NAME part
-# of the trailer (everything before the <email>). Blank lines and # comments are
-# ignored. These are deliberately uncopyable shape families, not accepted
-# answers; every angle-bracket slot must be replaced with runtime truth:
-#
-#     Co-Authored-By: <provider-model-family-and-version> <noreply@<vendor>.com>
-#     Co-Authored-By: <provider-model-series-and-route> <noreply@<vendor>.com>
-#
-# TO ADD A MODEL: append a line. No hook edit, no code change. Keep it specific
-# enough that a placeholder cannot slip through — `^ai$` would defeat the point.
-
-# --- Anthropic --------------------------------------------------------------
-^claude[[:space:]]+opus([[:space:]].*)?$
-^claude[[:space:]]+sonnet([[:space:]].*)?$
-^claude[[:space:]]+haiku([[:space:]].*)?$
-^claude[[:space:]]+fable([[:space:]].*)?$
-^claude([[:space:]]+[0-9].*)?$
-
-# --- OpenAI -----------------------------------------------------------------
-^gpt[-[:space:]]*[0-9.]+[[:space:]]+terra([[:space:]].*)?$
-^gpt[-[:space:]]*[0-9.]+[[:space:]]+luna([[:space:]].*)?$
-^gpt[-[:space:]]*[0-9.]+[[:space:]]+sol([[:space:]].*)?$
-^gpt[[:space:]]+terra([[:space:]].*)?$
-^gpt[[:space:]]+luna([[:space:]].*)?$
-^gpt[[:space:]]+sol([[:space:]].*)?$
-^gpt[-[:space:]]*[0-9.]+([[:space:]].*)?$
-^o[0-9]+([[:space:]].*)?$
-
-# --- DeepSeek ---------------------------------------------------------------
-^deepseek([[:space:]]+v[0-9.]+)?[[:space:]]+pro([[:space:]].*)?$
-^deepseek([[:space:]]+v[0-9.]+)?[[:space:]]+flash([[:space:]].*)?$
-^deepseek([[:space:]]+v[0-9.]+)?([[:space:]].*)?$
-
-# --- Moonshot ---------------------------------------------------------------
-^kimi[[:space:]]+k[0-9]+([[:space:]].*)?$
-# Dotted model versions, for example Kimi K3.1.
-^kimi[[:space:]]+k[0-9]+([.][0-9]+)*([[:space:]].*)?$
-
-# --- Google -----------------------------------------------------------------
-^gemini[[:space:]]*[0-9.]*([[:space:]].*)?$
-
-# --- Meta -------------------------------------------------------------------
-^llama[[:space:]]*[0-9.]*([[:space:]].*)?$
-
-# --- Mistral ----------------------------------------------------------------
-^mistral([[:space:]].*)?$
-^codestral([[:space:]].*)?$
-
-# --- xAI --------------------------------------------------------------------
-^grok[[:space:]]*[0-9.]*([[:space:]].*)?$
-
-# --- Qwen -------------------------------------------------------------------
-^qwen[[:space:]]*[0-9.]*([[:space:]].*)?$
-
-# --- Jcode ------------------------------------------------------------------
-# The Jcode agent harness (github.com/1jehuang/jcode). This lane runs as the
-# Jcode agent; the roster governs AGENT attribution, and the underlying model
-# route is not disclosed to the agent itself, so "Jcode" is the most specific
-# true name it can give. Added deliberately with the commit it authors.
-^jcode([[:space:]].*)?$
