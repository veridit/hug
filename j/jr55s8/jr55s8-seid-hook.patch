diff --git a/.githooks/commit-msg b/.githooks/commit-msg
index 47b2da2..b7ff7bc 100755
--- a/.githooks/commit-msg
+++ b/.githooks/commit-msg
@@ -1,124 +1,22 @@
-#!/bin/bash
-# commit-msg — every commit must name the model that ACTUALLY wrote it.
+#!/bin/sh
+# commit-msg: every commit names the model that ACTUALLY made it and the
+# effort it ran at, in one trailer line:
 #
-# WHY (King, 2026-08-26): "They commit as me, and add the extra line I wish...
-# but for the ACTUAL LLM running."
+#     Model: <model-id>/<effort>      (or Model: human, when the author wrote it)
 #
-# Every agent here commits as Jørgen H. Fjeld <jorgen@veridit.no> with the King's
-# signing key. Author, committer and signature are IDENTICAL across The Hedgehog,
-# the foreman and every lane, so git alone carries ZERO information about who did
-# the work. Proven the hard way: a guard written to detect a rebase dropping
-# "another author's" commits stayed SILENT on the real incident, because all three
-# parties were the same git identity. The trailer is the only attribution channel
-# this repo has, and it was used ZERO times in the 1500 commits before this hook.
+# WHY (King, 2026-08-26): every agent here commits as Jørgen H. Fjeld with the
+# King's signing key, so git alone cannot tell who did the work; the trailer is
+# the only attribution channel. Ruling 2026-11-17: one line, Model: id/effort,
+# because effort can change a model's behaviour entirely (hug jr55s8).
 #
-# THE COPY-PASTE PROBLEM (King, 2026-08-26): "the suggestion must then be generic,
-# so the model must replace". A concrete example in an error message gets pasted
-# verbatim, and then the log is confidently WRONG — worse than empty, because it
-# looks like attribution. So every family template this hook prints is
-# DELIBERATELY UNPASTABLE: any unreplaced <...> slot is refused.
+# The gate is hug's (hug task help install): it checks the model and its
+# effort against hug.toml [models] on the hug/tasks branch, and refuses each
+# mistake with a fix: line. Add a model with: hug task models add ID LEVEL...
+# This replaces the Co-Authored-By check and .githooks/known-models.txt.
 #
-# The roster of acceptable names lives in `.githooks/known-models.txt`, one regex
-# per line. Add a model by appending a line; no hook edit required.
-#
-# A hook cannot verify a model tells the truth about itself. It CAN force a
-# deliberate, specific, checkable claim. Honest self-identification is still
-# required — and now a lie has to be a lie, not an oversight.
-#
-# Exempt: merges, cherry-picks, reverts, rebases, fixup!/squash!/amend!.
-# Bypass: SEID_ALLOW_NO_COAUTHOR=1 (say why in the message).
-
-MSG_FILE="$1"
-HOOK_DIR=$(dirname "$0")
-ROOT=$(git -C "$HOOK_DIR/.." rev-parse --show-toplevel 2>/dev/null)
-GIT_DIR=$(git -C "$ROOT" rev-parse --absolute-git-dir 2>/dev/null)
-ROSTER="$ROOT/.githooks/known-models.txt"
-
-# --- exemptions -------------------------------------------------------------
-[ "${SEID_ALLOW_NO_COAUTHOR:-0}" = "1" ] && exit 0
-[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
-[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0
-[ -f "$GIT_DIR/REVERT_HEAD" ] && exit 0
-[ -d "$GIT_DIR/rebase-merge" ] && exit 0
-[ -d "$GIT_DIR/rebase-apply" ] && exit 0
-
-case "$(head -1 "$MSG_FILE")" in
-  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
-esac
-
-# --- helpers ----------------------------------------------------------------
-show_guidance() {
-  printf 'Trailer-shape families (replace EVERY <...> slot before retrying):\n\n' >&2
-  printf '    Co-Authored-By: <provider-and-model-family> <noreply@<vendor>.com>\n' >&2
-  printf '    Co-Authored-By: <provider-model-family-and-version> <noreply@<vendor>.com>\n' >&2
-  printf '    Co-Authored-By: <provider-model-series-and-route> <noreply@<vendor>.com>\n\n' >&2
-  printf 'The accepted model families are regexes in .githooks/known-models.txt.\n' >&2
-  printf 'That roster includes multiple families per provider; the hook does not\n' >&2
-  printf 'hard-code one model as the answer. If your family is absent, append its\n' >&2
-  printf 'regex in the SAME commit so the roster grows deliberately.\n\n' >&2
-}
-
-# --- extract the trailer ----------------------------------------------------
-TRAILER=$(grep -iE '^Co-Authored-By:' "$MSG_FILE" | head -1)
-
-if [ -z "$TRAILER" ]; then
-  printf '\n\033[31mcommit-msg: REFUSED — missing Co-Authored-By trailer\033[0m\n\n' >&2
-  printf 'Every agent here commits as the King, with the King'"'"'s signing key. Git\n' >&2
-  printf 'cannot tell you apart. Name the model you ACTUALLY are.\n\n' >&2
-  show_guidance
-  printf 'If someone TOLD you which model to name: that is not attribution,\n' >&2
-  printf 'it is dictation. Name what you are, or refuse and say who told you.\n\n' >&2
-  printf 'Exempt: merges, cherry-picks, reverts, fixup!/squash!.\n' >&2
-  printf 'Override: SEID_ALLOW_NO_COAUTHOR=1 (and say why in the message).\n\n' >&2
-  exit 1
-fi
-
-# Every shape printed above contains an angle-bracket slot. Catch a literal
-# paste before parsing so the refusal explains the actual mistake.
-if printf '%s' "$TRAILER" | grep -qiE '<[^>]*(provider|model|family|version|series|route|vendor|actual|your)[^>]*>|placeholder'; then
-  printf '\n\033[31mcommit-msg: REFUSED — a trailer-shape slot was pasted, not replaced\033[0m\n\n' >&2
-  printf '    got: %s\n\n' "$TRAILER" >&2
-  printf 'Every <...> slot is an instruction, never an accepted value.\n\n' >&2
-  show_guidance
-  exit 1
-fi
-
-# Require one exact trailer: a non-placeholder name, then one ordinary email
-# address in angle brackets, with no suffix or second address.
-if ! printf '%s\n' "$TRAILER" | grep -qiE '^Co-Authored-By:[[:space:]]+[^<>[:space:]][^<>]*[[:space:]]+<[^<>[:space:]@]+@[^<>[:space:]@]+>[[:space:]]*$'; then
-  printf '\n\033[31mcommit-msg: REFUSED — malformed Co-Authored-By trailer\033[0m\n\n' >&2
-  printf '    got: %s\n\n' "$TRAILER" >&2
-  printf 'Supply one actual model name and one vendor email, with nothing after it.\n\n' >&2
-  show_guidance
-  exit 1
-fi
-
-NAME=$(printf '%s' "$TRAILER" | sed -E 's/^[Cc][Oo]-[Aa]uthored-[Bb]y:[[:space:]]+//; s/[[:space:]]+<[^<>[:space:]@]+@[^<>[:space:]@]+>[[:space:]]*$//')
-
-# --- roster check -----------------------------------------------------------
-if [ ! -f "$ROSTER" ]; then
-  printf '\n\033[31mcommit-msg: REFUSED — roster missing: %s\033[0m\n\n' "$ROSTER" >&2
-  printf 'The known-model list is part of the repo. Restore it before committing.\n\n' >&2
-  exit 1
-fi
-
-MATCHED=0
-while IFS= read -r pattern; do
-  case "$pattern" in ''|'#'*) continue ;; esac
-  if printf '%s' "$NAME" | grep -qiE "$pattern"; then
-    MATCHED=1
-    break
-  fi
-done < "$ROSTER"
-
-if [ "$MATCHED" -eq 0 ]; then
-  printf '\n\033[31mcommit-msg: REFUSED — "%s" is not a known model\033[0m\n\n' "$NAME" >&2
-  printf 'This is not a real model name, or the roster does not know it yet.\n' >&2
-  printf 'Generic words (AI, LLM, assistant, agent, bot) are refused on purpose:\n' >&2
-  printf 'a vague name makes the log confidently misleading, which is worse than\n' >&2
-  printf 'no attribution at all.\n\n' >&2
-  show_guidance
-  exit 1
-fi
-
-exit 0
+# Exempt (in hug's gate): merges, cherry-picks, reverts, rebases,
+# fixup!/squash!/amend!, and the hug/tasks and muninn-notes branches.
+# Bypass: git commit --no-verify (say why in the message).
+h="$(git rev-parse --git-common-dir)/hooks/hug-commit-msg"
+[ -x "$h" ] || { echo "commit refused: hug's Model: gate is not installed" >&2; echo "fix: hug task install commit-msg" >&2; exit 1; }
+"$h" "$@" || exit 1
